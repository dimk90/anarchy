#!/bin/sh

# Guard every snapshot cmdline against resume, including the HibernateLocation EFI
# fallback. SNAPSHOT_KERNEL_PARAMETERS+=noresume only affects new manifest entries;
# this hook also protects old cmdlines replayed from snapshots.json on every sync.
# Stop at the next depth-1/2 entry so //Current and UKI entries stay untouched.
# Run before config-checksum enrollment; do not duplicate an existing noresume token.
sed -i -E '
    /^[[:space:]]*\/\/[+]?Snapshots[[:space:]]*$/,/^[[:space:]]*\/{1,2}([^/]|$)/ {
        /^[[:space:]]*(kernel_)?cmdline:/I {
            s/[[:space:]]+resume(_offset)?=[^[:space:]]*//g
            /[[:space:]]noresume([[:space:]]|$)/! s/$/ noresume/
        }
    }
' /boot/limine.conf
