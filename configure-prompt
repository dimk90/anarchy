#!/bin/bash

# Treat unset variables as an error and exit immediately
set -o nounset


## Imports


set -o errexit # exit on non-zero exit code

COMMON=$(curl -fsSL "https://dimk90.github.io/anarchy/common")
# shellcheck source=common
source <(echo "$COMMON")

set +o errexit # disable exit on non-zero exit code


## Globals


# The FHS location for locally installed fonts: fontconfig scans it by default
# on both Arch and Ubuntu, and no package manager owns it
FONT_DIR='/usr/local/share/fonts'

# Optional components picked in the up-front menu, lowercased, one per line
COMPONENTS=''

# Starship theme picked in the up-front menu
THEME='pure'


## Routines


select_components() {
    #
    # Ask which optional components to configure and store the answer in
    # COMPONENTS. Starship itself is not listed - it is the point of the script.
    # Fish entries are offered only when fish is installed.
    #
    # Parameters:
    #   None.
    #
    # Example:
    #   select_components
    #
    printf_section "Components\n"

    local items=('Iosevka Term font' 'Nerd Symbols font')
    is_command_available 'fish' &&
        items+=('Fish colors' 'Fish greeting' 'Fish key bindings')

    local header
    header=$(prefix_printf "$(bullet_action)" 'Select optional components:\n')

    local choices
    if choices=$(gum choose --no-limit --selected='*' \
                            --cursor="      > "       \
                            --header="${header}"      \
                            "${items[@]}"); then
        COMPONENTS=${choices,,} # lowercase for matching
    fi

    local num_choice
    num_choice=$([ -n "$COMPONENTS" ] && wc -l <<< "$COMPONENTS" || echo 0)
    printf_action "Selected components: ${STYLE_CLR}${num_choice}\n"
}


select_theme() {
    #
    # Ask which starship theme to install and store the answer in THEME.
    # Keeps its default on an aborted menu, so the caller always has a theme.
    #
    # Parameters:
    #   None.
    #
    # Example:
    #   select_theme
    #
    local header
    header=$(prefix_printf "$(bullet_action)" 'Select starship theme (default: pure):\n')

    THEME=$(gum choose --cursor="      > "  \
                       --header="${header}" \
                       --limit=1            \
                       'pure' 'capsule' 'pure-text') || THEME='pure'
    printf_action "Starship theme: ${STYLE_CLR}${THEME}\n"
}


has_component() {
    #
    # Check whether a component was selected in the up-front menu.
    #
    # Parameters:
    #   $1 - name - lowercased component name as shown in the menu.
    #
    # Example:
    #   has_component 'fish colors' && configure_colors
    #
    grep -q "$1" <<< "$COMPONENTS"
}


# shellcheck disable=SC2329
install_starship_upstream() {
    curl -fsSL https://starship.rs/install.sh | sh -s -- --yes
}


install_starship() {
    #
    # Ensure starship is installed.
    # Returns 0 on success, non-zero otherwise.
    #
    # Ubuntu ships a starship package only since 25.10 (nothing on 24.04 LTS)
    # and upstream publishes no .deb, so outside Arch we use the official
    # installer, which puts the binary in /usr/local/bin. dpkg knows nothing
    # about that install, hence the is_command_available guard instead of
    # the dpkg-based check inside action_require_package.
    #
    if [ "$(get_package_manager)" = 'pacman' ]; then
        action_require_package 'starship'
        return $?
    fi

    if is_command_available 'starship'; then
        action_run "Package ${STYLE_CLR}$(gum style --bold --foreground "$GUM_YELLOW" 'starship')" '' 'exists'
        return $?
    fi

    # The installer escalates on its own with a bare `sudo`; cache the
    # credential first so its password prompt can't hide inside the spinner.
    action_request_permission 'to install starship'

    export -f install_starship_upstream
    action_run "Install ${STYLE_CLR}$(gum style --bold --foreground "$GUM_YELLOW" 'starship')$(gum style --faint ' from starship.rs')" \
        'install_starship_upstream' 'installed'
}


install_font() {
    #
    # Install a bundled font system-wide, replacing any previously installed copy.
    #
    # The existing file is removed up front instead of being backed up:
    # action_install_file would leave a multi-megabyte .bakN beside it, and
    # fc-cache indexes every file in the directory, so the backup would show up
    # as a duplicate face. Losing the old copy if the download then fails is
    # harmless - it is re-fetchable from the same URL.
    #
    # Parameters:
    #   $1 - font_file - path of the font under font/ in the repo.
    #
    # Example:
    #   install_font 'Iosevka/IosevkaTerm.ttc'
    #
    local font_file="$1"

    local font_path="${FONT_DIR}/${font_file##*/}"

    as_root rm -f "$font_path" &>> "$LOG_FILE"
    assert $? "can't remove existing font: $font_path"

    action_install_file "$font_path" \
        "https://dimk90.github.io/anarchy/font/${font_file}" \
        "$(check_sudo)"
}


install_fonts() {
    #
    # Install the fonts selected in the components menu system-wide.
    # Returns 0 without touching anything when no font was selected.
    #
    # Parameters:
    #   None.
    #
    # Example:
    #   install_fonts
    #
    has_component 'iosevka term font' || has_component 'nerd symbols font' || return 0

    printf_section "Fonts\n"

    # fc-cache ships in fontconfig, same package name on Arch and Ubuntu
    action_require_package 'fontconfig'

    action_request_permission 'to install fonts system-wide'

    action_run "Create ${STYLE_CLR}${FONT_DIR}" \
        "$(check_sudo) mkdir -p ${FONT_DIR}" 'done'
    assert $? "can't create font directory: $FONT_DIR"

    # Iosevka Term carries no Nerd Font glyphs; the pure and capsule themes get
    # theirs from Nerd Symbols, which fontconfig picks up as a fallback
    has_component 'iosevka term font' && install_font 'Iosevka/IosevkaTerm.ttc'
    has_component 'nerd symbols font' && install_font 'NerdSymbols/SymbolsNerdFont.ttf'

    action_run 'Rebuild font cache' "$(check_sudo) fc-cache -f" 'done'
    assert $? 'failed to rebuild font cache'
}


# shellcheck disable=SC2329
fish_configure_highlighting() {
    # ANSI color codes:
    # https://hexdocs.pm/color_palette/ansi_color_codes.html

    # All 'set -U' calls are batched into a single fish invocation to avoid
    # spawning a separate fish process per variable.
    fish -c '
        # Syntax highlighting
        # https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
        set -U fish_color_normal AAA
        set -U fish_color_command 5BF --bold
        set -U fish_color_operator 0FB --bold       # ( ), { }, ...
        set -U fish_color_param normal              # Disable highlighting
        set -U fish_color_autosuggestion 444
        set -U fish_color_comment 464 --italic
        set -U fish_color_quote BE7                 # "Text"
        set -U fish_color_escape 9EC                # "...\n"
        set -U fish_color_valid_path --underline
        set -U fish_color_error D55
        set -U fish_color_end FD6                   # Separators like ; and &
        set -U fish_color_redirection FD6           # Like >/dev/null
        set -U fish_color_history_current --bold
        set -U fish_color_search_match normal       # Disable highlighting

        # Pager
        # https://fishshell.com/docs/current/interactive.html#pager-color-variables
        set -U fish_pager_color_prefix brwhite --bold
        set -U fish_pager_color_selected_prefix black
        set -U fish_pager_color_completion normal
        set -U fish_pager_color_selected_completion black
        set -U fish_pager_color_description 555
        set -U fish_pager_color_selected_description black
        set -U fish_pager_color_selected_background --background=AFA
        set -U fish_pager_color_progress black --background=7FF
    '
}


# shellcheck disable=SC2329
fish_configure_greeting() {
    # The emoji width rides along: both are cosmetic startup settings the
    # greeting opt-out covers.
    fish -c '
        # Hide fish greeting
        set -U fish_greeting ""

        # Set the emoji width (iTerm only?)
        set -U fish_emoji_width 2
    '
}


fish_install_key_bindings() {
    #
    # Install ctrl-arrow word motions and ctrl-backspace/delete word kills.
    #
    # fish autoloads a function named fish_user_key_bindings from its functions
    # directory, so config.fish needs no entry.
    #
    # The `bind ctrl-right` key notation arrived in fish 4.0; older fish binds
    # the literal characters instead, so skip rather than mangle the keymap.
    #
    # Parameters:
    #   None.
    #
    # Example:
    #   fish_install_key_bindings
    #
    local version
    # shellcheck disable=SC2016  # $version is a fish variable, expanded by fish
    version=$(fish -c 'echo $version' 2>> "$LOG_FILE")

    local major="${version%%.*}"
    if ! [[ "$major" =~ ^[0-9]+$ ]] || [ "$major" -lt 4 ]; then
        printf_action "%b ${STYLE_DIM}Key bindings need fish 4.0+, found ${STYLE_CLR}%s\n" \
            "$(bullet_warning)" "${version:-unknown}"
        return 0
    fi

    mkdir -p ~/.config/fish/functions
    assert $? 'failed to create fish functions directory'

    action_install_file ~/.config/fish/functions/fish_user_key_bindings.fish \
        "https://dimk90.github.io/anarchy/prompt/fish_user_key_bindings.fish"
}


# shellcheck disable=SC2329
fish_enable_starship() {
    # Ensure fish functions directory exists
    mkdir -p ~/.config/fish/functions
    assert $? 'failed to create fish functions directory'

    # Install starship config selector (autoloaded by fish)
    action_install_file ~/.config/fish/functions/select_starship_config.fish \
        "https://dimk90.github.io/anarchy/prompt/select_starship_config.fish"

    # Remove old starship init to guarantee select_starship_config call before init
    remove_line ~/.config/fish/config.fish 'starship init fish'
    assert $? 'failed to remove old starship init'

    # Add starship init with config selector
    config_set_param ~/.config/fish/config.fish \
        'select_starship_config; starship init fish \| source'
    assert $? 'failed to add starship init with config selector'
}


# shellcheck disable=SC2329
bash_enable_starship() {
    # Download starship config selector function
    action_install_file ~/.config/starship/select_starship_config.bash \
        "https://dimk90.github.io/anarchy/prompt/select_starship_config.bash"

    # Remove old starship init to guarantee select_starship_config call before init
    remove_line ~/.bashrc 'starship init bash'
    assert $? 'failed to remove old starship init'

    # Drop any previous inline selector definition from .bashrc (multi-line block)
    sed -i '/^select_starship_config() {$/,/^}$/d' ~/.bashrc &>> "$LOG_FILE"
    assert $? 'failed to remove old starship config selector'

    # Source config selector
    config_set_param ~/.bashrc \
        'source ~/\.config/starship/select_starship_config\.bash'
    assert $? 'failed to add starship config selector source'

    # Add starship init with config selector
    config_set_param ~/.bashrc \
        'select_starship_config && eval "\$\(starship init bash\)"'
    assert $? 'failed to add starship init with config selector'
}


main() {

    ## Get gum

    request_gum
    assert $? 'no gum - no fun :('

    ## Init

    printf_section "Starting\n"
    printf_action "Common lib version: ${STYLE_CLR}${COMMON_VERSION}\n"
    start_logger
    printf_action "Log started: ${STYLE_CLR}${LOG_FILE}\n"

    ## Components

    select_components
    select_theme

    ## Starship

    printf_section "Starship\n"
    install_starship
    assert $? 'failed to install starship'

    # Create starship dir for configs
    mkdir -p ~/.config/starship
    assert $? 'failed to create starship config directory'

    # Download fallback theme
    printf_action "Fallback theme: ${STYLE_CLR}pure-text\n"
    action_install_file ~/.config/starship/fallback.toml \
        "https://dimk90.github.io/anarchy/prompt/starship.pure-text.toml"

    # Download the selected theme
    action_install_file ~/.config/starship/starship.toml \
        "https://dimk90.github.io/anarchy/prompt/starship.${THEME}.toml"

    ## Fonts

    install_fonts

    ## Fish

    if is_command_available 'fish'; then
        printf_section "Configure fish\n"

        if has_component 'fish colors'; then
            export -f fish_configure_highlighting
            action_run 'Configure syntax highlighting' 'fish_configure_highlighting' 'done'
        fi

        if has_component 'fish greeting'; then
            export -f fish_configure_greeting
            action_run 'Configure greeting' 'fish_configure_greeting' 'done'
        fi

        export -f fish_enable_starship
        action_run 'Enable starship' 'fish_enable_starship' 'done'

        has_component 'fish key bindings' && fish_install_key_bindings
    fi

    ## Bash

    if is_command_available 'bash'; then
        printf_section "Configure bash\n"

        export -f bash_enable_starship
        action_run 'Enable starship' 'bash_enable_starship' 'done'
    fi

    printf_info "Restart your shell to apply the new configuration\n"

    return 0
}


main "$@"
