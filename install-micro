#!/bin/bash

# Treat unset variables as an error and exit immediately
set -o nounset


## Imports


set -o errexit # exit on non-zero exit code

COMMON=$(curl -fsSL "https://dimk90.github.io/anarchy/common")
# shellcheck source=common
source <(echo "$COMMON")

set +o errexit # disable exit on non-zero exit code


## Routines


main() {

    ## Init

    action_start_tui

    ## Ask user for items to install

    local choices
    choices=$(action_choose_items 'Confirm Items' \
                  'Settings' 'Keybindings' 'Default Editor' 'Clipboard Support') || return 0

    # Empty choice means nothing to do -> exit
    if [ -z "$choices" ]; then
        echo
        return 0
    fi

    ## Install micro

    printf_section "Installing & Configuring\n"

    action_require_package 'micro'

    # Install clipboard helpers (xclip for X11, wl-clipboard for Wayland); micro's
    # default clipboard=external shells out to whichever matches the running session
    if has_choice "$choices" 'clipboard support'; then
        action_require_package 'xclip'
        action_require_package 'wl-clipboard'
    fi

    # Create micro config directory if it doesn't exist
    mkdir -p ~/.config/micro
    assert $? "can't create ~/.config/micro"

    ## Install selected items

    local shells

    # Install settings file
    if has_choice "$choices" 'settings'; then
        action_install_file "${HOME}/.config/micro/settings.json"  \
                            'https://dimk90.github.io/anarchy/micro/settings.json'

        # Replace obsolete MICRO_TRUECOLOR with truecolor=auto in settings (since micro 2.0.15)
        shells="$(env_unset_permanent 'MICRO_TRUECOLOR')"
        [ -n "$shells" ] && action_run "Remove MICRO_TRUECOLOR (in favor of settings) for ${STYLE_CLR}${STYLE_BOLD}$shells"
    fi

    # Install keybindings
    if has_choice "$choices" 'keybindings'; then
        action_install_file "${HOME}/.config/micro/bindings.json"  \
                            'https://dimk90.github.io/anarchy/micro/bindings.json'

        # bindings.json maps Alt+Up to the movelines plugin, which fixes micro's
        # missing upward scroll when moving a selected block off the top of the view
        mkdir -p ~/.config/micro/plug/movelines
        assert $? "can't create ~/.config/micro/plug/movelines"
        action_install_file "${HOME}/.config/micro/plug/movelines/movelines.lua"  \
                            'https://dimk90.github.io/anarchy/micro/movelines.lua'
    fi

    # Set as default editor
    if has_choice "$choices" 'default editor'; then
        shells="$(env_set_permanent 'EDITOR' 'micro')"
        [ -n "$shells" ] && action_run "Set EDITOR to micro for ${STYLE_CLR}${STYLE_BOLD}$shells"
    fi

    return 0
}


main "$@"
