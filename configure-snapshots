#!/bin/bash

# Treat unset variables as an error and exit immediately
set -o nounset


## Imports


set -o errexit # exit on non-zero exit code

COMMON=$(curl -fsSL "https://dimk90.github.io/anarchy/common")
# shellcheck source=common
source <(echo "$COMMON")

set +o errexit # disable exit on non-zero exit code


## Constants


# UKI built by configure-boot - its BLAKE2B is embedded in limine.conf and its
# NVRAM entry must stay ahead of Limine in the boot order.
UKI_PATH='/boot/EFI/Linux/arch-linux.efi'
UKI_LABEL='Arch Linux (UKI)'

# Split boot artifacts //Current points at - and so does every snapshot entry
# limine-snapper-sync clones from it. vmlinuz-linux ships with the linux
# package, initramfs-linux.img is the mkinitcpio preset's default_image, and
# intel-ucode.img comes from intel-ucode.
SPLIT_BOOT_FILES=('/boot/vmlinuz-linux' '/boot/initramfs-linux.img' '/boot/intel-ucode.img')

# Limine bootloader binary + NVRAM entry
LIMINE_LABEL='Limine (Snapshots)'
LIMINE_EFI_SRC='/usr/share/limine/BOOTX64.EFI'
LIMINE_EFI_DST='/boot/EFI/limine/limine_x64.efi'
LIMINE_LOADER='\EFI\limine\limine_x64.efi'

# Canonical Limine config (the deep copy under EFI/limine/ goes stale silently
# and must be moved aside - limine-snapper-sync only updates the root one).
LIMINE_CONF='/boot/limine.conf'
DEEP_LIMINE_CONF='/boot/EFI/limine/limine.conf'

# post.d hooks limine-snapper-sync runs after rewriting limine.conf (resume
# strip, optional menu flatten). Created here - limine-entry-tool, which ships
# the dir, isn't installed until the Secure Boot step.
BOOT_HOOKS_DIR='/etc/boot/hooks/post.d'

# Drop-in that pulls snapper-timeline.timer from hourly to daily creation
TIMELINE_DROPIN_DIR='/etc/systemd/system/snapper-timeline.timer.d'
TIMELINE_DROPIN='daily.conf'

# Encrypted btrfs holding @ and the snapshot holders - must match configure-disk.
CRYPT_NAME='cryptroot'
CRYPT_DEV="/dev/mapper/${CRYPT_NAME}"

# Asset URLs (served by the GitHub Pages site)
BASE_URL='https://dimk90.github.io/anarchy'
LIMINE_CONF_URL="${BASE_URL}/boot/limine.conf"
LIMINE_THEME_URL="${BASE_URL}/boot/limine-theme.conf"
LIMINE_HOOK_URL="${BASE_URL}/boot/99-limine.hook"
LIMINE_DEFAULT_URL="${BASE_URL}/boot/limine.default"
LIMINE_STRIP_HOOK_URL="${BASE_URL}/boot/81-limine-strip-resume"
LIMINE_FLATTEN_HOOK_URL="${BASE_URL}/boot/80-limine-flatten-snapshots"
TIMELINE_DROPIN_URL="${BASE_URL}/snapper/timeline-daily.conf"

# Limine menu bitmap fonts (deployed to the ESP root; theme term_font picks one)
LIMINE_FONT_BASE_URL="${BASE_URL}/font/limine"   # /<name>-8x16.bin

# AUR companion: turns each new snapper snapshot into a Limine boot entry.
# limine-mkinitcpio-hook is deliberately left out - it provides (and conflicts
# with) limine-entry-tool, which the Secure Boot step installs on its own.
AUR_SYNC_TOOL='limine-snapper-sync'


## Globals (set at runtime)


# Snapshot targets (toggled in select_snapshot_targets)
WANT_ROOT=true
WANT_HOME=true

# Limine components (toggled in select_limine_options, root target only)
WANT_THEME=true
WANT_FLATTEN=true

# Limine menu font (set in select_limine_options when WANT_THEME)
LIMINE_FONT='spleen'

# ESP disk + partition index for the efibootmgr entry (set in verify_prerequisites)
ESP_DISK=''
ESP_IDX=''

# Cryptroot UUID for the holder fstab lines (set in verify_prerequisites)
CRYPT_UUID=''

# Owned temporary resources; their EXIT trap is armed only while they are live
# because common's action_install_file manages its own EXIT trap.
_SNAPSHOTS_TEMP_FILE=''
_SNAPSHOTS_TOP=''


## Routines


detect_esp_mount() {
    #
    # Print the partition device path mounted at /boot.
    #
    findmnt -n -o SOURCE /boot 2>>"$LOG_FILE"
}


parse_disk_part() {
    #
    # Convert a partition device path to "<disk>|<index>".
    #   /dev/nvme0n1p1 -> /dev/nvme0n1|1
    #   /dev/sda1      -> /dev/sda|1
    # NVMe-style needs the 'p' separator (digit before 'p' before idx).
    #
    local part="$1"
    local disk='' idx=''

    if [[ "$part" =~ ^(.*[0-9])p([0-9]+)$ ]]; then
        disk="${BASH_REMATCH[1]}"
        idx="${BASH_REMATCH[2]}"
    elif [[ "$part" =~ ^(.*[^0-9])([0-9]+)$ ]]; then
        disk="${BASH_REMATCH[1]}"
        idx="${BASH_REMATCH[2]}"
    fi

    echo "${disk}|${idx}"
}


# shellcheck disable=SC2329
is_root_btrfs_subvol_at() {
    #
    # Check whether '/' is mounted on btrfs with subvol=@. The snapshot layout
    # (and the cmdline baked into the UKI) assumes this.
    #
    local fstype subvol
    fstype=$(findmnt -n -o FSTYPE / 2>>"$LOG_FILE")
    [ "$fstype" = 'btrfs' ] || return 1

    subvol=$(findmnt -n -o OPTIONS / 2>>"$LOG_FILE" | grep -oE 'subvol=[^,]+' | head -n 1)
    [ "$subvol" = 'subvol=/@' ] || [ "$subvol" = 'subvol=@' ]
}


# shellcheck disable=SC2329
reorder_bootorder() {
    #
    # Put the UKI first and Limine second in the UEFI boot order, preserving the
    # rest. Returns 1 if either entry can't be found in NVRAM.
    #
    local out uki lim order rest neworder
    out=$(as_root efibootmgr 2>>"$LOG_FILE")

    uki=$(grep -F "$UKI_LABEL" <<< "$out" \
          | grep -oE '^Boot[0-9A-Fa-f]{4}' | head -n1 | sed 's/^Boot//')
    lim=$(grep -F "$LIMINE_LABEL" <<< "$out" \
          | grep -oE '^Boot[0-9A-Fa-f]{4}' | head -n1 | sed 's/^Boot//')

    [ -z "$uki" ] && return 1
    [ -z "$lim" ] && return 1

    order=$(grep -E '^BootOrder:' <<< "$out" | sed -E 's/^BootOrder:[[:space:]]*//')
    rest=$(tr ',' '\n' <<< "$order" | grep -viE "^(${uki}|${lim})$" | paste -sd ',' -)

    if [ -n "$rest" ]; then
        neworder="${uki},${lim},${rest}"
    else
        neworder="${uki},${lim}"
    fi

    as_root efibootmgr --bootorder "$neworder" &>> "$LOG_FILE"
}


# shellcheck disable=SC2329
apply_root_retention() {
    #
    # Retention for the 'root' config: snap-pac is the only trigger, no
    # timeline, a real rollback window, drop empty pre/post pairs.
    #
    as_root snapper -c root set-config \
        ALLOW_GROUPS=wheel             \
        SYNC_ACL=yes                   \
        NUMBER_CLEANUP=yes             \
        NUMBER_MIN_AGE=1800            \
        NUMBER_LIMIT=20                \
        NUMBER_LIMIT_IMPORTANT=10      \
        TIMELINE_CREATE=no             \
        TIMELINE_CLEANUP=yes           \
        TIMELINE_LIMIT_HOURLY=0        \
        TIMELINE_LIMIT_DAILY=0         \
        TIMELINE_LIMIT_WEEKLY=0        \
        TIMELINE_LIMIT_MONTHLY=0       \
        TIMELINE_LIMIT_YEARLY=0        \
        EMPTY_PRE_POST_CLEANUP=yes     \
        EMPTY_PRE_POST_MIN_AGE=1800
}


# shellcheck disable=SC2329
apply_home_retention() {
    #
    # Retention for the 'home' config: timeline is the only trigger, daily
    # granularity with weekly + monthly fallback. Nothing opts out of pacman
    # here - snap-pac only snapshots the config named 'root' by default, and
    # snapper rejects keys outside snapper-configs(5) as invalid configdata.
    #
    as_root snapper -c home set-config \
        ALLOW_GROUPS=wheel             \
        SYNC_ACL=yes                   \
        NUMBER_CLEANUP=no              \
        TIMELINE_CREATE=yes            \
        TIMELINE_CLEANUP=yes           \
        TIMELINE_MIN_AGE=1800          \
        TIMELINE_LIMIT_HOURLY=0        \
        TIMELINE_LIMIT_DAILY=7         \
        TIMELINE_LIMIT_WEEKLY=4        \
        TIMELINE_LIMIT_MONTHLY=3       \
        TIMELINE_LIMIT_YEARLY=0        \
        EMPTY_PRE_POST_CLEANUP=no
}


select_snapshot_targets() {
    #
    # Ask which subvolumes to snapshot. Sets WANT_ROOT / WANT_HOME.
    # Returns 1 on cancel or an empty selection - there's nothing to configure
    # without a target, and everything downstream hangs off these two flags.
    #
    local choices
    choices=$(action_choose_items --label 'targets' 'Select Snapshot Targets'  \
                  'Root snapshots - pacman-triggered config for / (+ Limine)'  \
                  'Home snapshots - timeline config for /home') || return 1

    WANT_ROOT=false
    WANT_HOME=false
    has_choice "$choices" 'root snapshots' && WANT_ROOT=true
    has_choice "$choices" 'home snapshots' && WANT_HOME=true

    if [ "$WANT_ROOT" = false ] && [ "$WANT_HOME" = false ]; then
        printf_action "%b ${STYLE_DIM}no target selected - nothing to do${STYLE_CLR}\n" \
            "$(bullet_info)"
        return 1
    fi

    return 0
}


select_limine_options() {
    #
    # Ask which optional Limine components to set up. Only the root target
    # boots snapshots, so this is skipped entirely for a home-only run. Sets
    # WANT_THEME / WANT_FLATTEN, and LIMINE_FONT when the theme is selected.
    # Returns 1 on cancel.
    #
    local choices
    choices=$(action_choose_items 'Select Limine Options'                            \
                  'Limine theme - monochrome HiDPI menu styling'                     \
                  'Flatten snapshot submenus - drop the redundant //// menu level') || return 1

    WANT_THEME=false
    WANT_FLATTEN=false
    has_choice "$choices" 'limine theme'     && WANT_THEME=true
    has_choice "$choices" 'flatten snapshot' && WANT_FLATTEN=true

    # The menu font lives in the theme block - only ask when the theme is on.
    if [ "$WANT_THEME" = true ]; then
        local header
        header=$(prefix_printf "$(bullet_action)" 'Select Limine menu font (default: spleen):\n')
        LIMINE_FONT=$(gum choose --cursor='      > '  \
                                 --header="${header}" \
                                 --limit=1            \
                                 'spleen' 'terminus' 'profont' 'default') || LIMINE_FONT='spleen'
        printf_action "Limine menu font: ${STYLE_CLR}${LIMINE_FONT}\n"
    fi

    return 0
}


install_limine() {
    #
    # Everything Limine under one section: the official package, the AUR
    # companion, the bootloader binary + its pacman hook, limine.conf, the stale
    # deep-config eviction, the menu font, the NVRAM entry, /etc/default/limine,
    # and the post.d boot hooks. Root target only - Limine boots snapshots of @,
    # and /home snapshots have no boot entries. Each step keeps its own
    # action_request_permission - a silent no-op while sudo is cached, but it
    # re-asserts privilege right before its work (the AUR build can outlast the
    # sudo timestamp) and documents that step's intent.
    #
    printf_section "Installing Limine\n"

    action_require_package 'limine'

    install_sync_tool
    install_limine_bootloader
    write_limine_config
    move_deep_config_aside
    deploy_menu_font
    register_limine_nvram
    install_sync_defaults
    install_boot_hooks
}


verify_prerequisites() {
    #
    # Pre-flight checks, gated by target: the Limine/boot assumptions only hold
    # for root snapshots, so a home-only run must not be aborted by them.
    # Cryptroot is shared - its UUID anchors every holder fstab line.
    #
    printf_section "Verifying Prerequisites\n"

    action_request_permission 'to inspect the system'

    [ "$WANT_ROOT" = true ] && verify_root_prerequisites
    [ "$WANT_HOME" = true ] && verify_home_prerequisites

    # cryptroot mapper present - its UUID anchors the holder fstab lines, and
    # holders are siblings on this btrfs. (Missing holders are provisioned
    # later, so there's no fstab-presence gate here.)
    if ! action_run "Cryptroot mapper ${STYLE_CLR}${CRYPT_DEV}"  \
                    "as_root test -e '$CRYPT_DEV'"              \
                    'present'                                   \
                    'missing'; then
        printf_error "${CRYPT_DEV} not open - snapshots require the configure-disk layout\n"
        exit 1
    fi

    CRYPT_UUID=$(as_root blkid -s UUID -o value "$CRYPT_DEV" 2>>"$LOG_FILE")
    [ -z "$CRYPT_UUID" ] && assert 1 "can't read UUID for ${CRYPT_DEV}"
    printf_action "Cryptroot UUID: ${STYLE_CLR}${CRYPT_UUID}\n"

    printf_action 'Proceed? '
    ask_yn || exit 0
}


verify_root_prerequisites() {
    #
    # Checks the root target adds: the AUR helper, the UEFI/ESP side Limine
    # needs, and the boot artifacts //Current (and every snapshot entry cloned
    # from it) points at. Each step is an action_run so the section is never
    # empty: failure renders a red status, the trailing exit gives the
    # diagnostic. Sets ESP_DISK / ESP_IDX for the NVRAM entry.
    #
    # 1. yay present (AUR tools build only as a normal user)
    if ! action_run "AUR helper ${STYLE_CLR}yay"  \
                    'command -v yay'              \
                    'present'                     \
                    'missing'; then
        printf_error "yay not found - run install-yay first\n"
        exit 1
    fi

    # 2. UEFI boot mode (efibootmgr needs it)
    if ! action_run 'UEFI boot mode'        \
                    '[ -d /sys/firmware/efi ]' \
                    'yes'                   \
                    'no'; then
        printf_error "not booted in UEFI mode - can't register Limine in NVRAM\n"
        exit 1
    fi

    # 3. ESP mounted at /boot
    local esp_part
    esp_part=$(detect_esp_mount)
    if ! action_run "ESP mounted at ${STYLE_CLR}/boot"  \
                    "[ -n '$esp_part' ]"                \
                    'mounted'                           \
                    'missing'; then
        printf_error "ESP not mounted at /boot - mount it and re-run\n"
        exit 1
    fi

    local disk_part
    disk_part=$(parse_disk_part "$esp_part")
    ESP_DISK="${disk_part%|*}"
    ESP_IDX="${disk_part##*|}"
    if [ -z "$ESP_DISK" ] || [ -z "$ESP_IDX" ]; then
        printf_error "can't parse ESP partition path: %s\n" "$esp_part"
        exit 1
    fi
    printf_action "ESP: ${STYLE_CLR}%b ${STYLE_DIM}(disk ${STYLE_CLR}%b${STYLE_DIM}, part ${STYLE_CLR}%b${STYLE_DIM})\n" \
        "$(gum style --bold --foreground "$GUM_YELLOW" "$esp_part")"  \
        "$(gum style --bold --foreground "$GUM_YELLOW" "$ESP_DISK")"  \
        "$(gum style --bold --foreground "$GUM_YELLOW" "$ESP_IDX")"

    # 4. root is btrfs subvol=@
    export -f is_root_btrfs_subvol_at
    if ! action_run 'Root filesystem (btrfs subvol=@)'  \
                    'is_root_btrfs_subvol_at'           \
                    'btrfs subvol=@'                    \
                    'mismatch'; then
        printf_error "/ is not btrfs subvol=@ - snapshots require the configure-disk layout\n"
        exit 1
    fi

    # 5. UKI present (built by configure-boot); /boot is root-only (umask 0077)
    if ! action_run "UKI ${STYLE_CLR}${UKI_PATH}"  \
                    "as_root test -f '$UKI_PATH'"  \
                    'present'                      \
                    'missing'; then
        printf_error "UKI not found at ${UKI_PATH} - run configure-boot first\n"
        exit 1
    fi

    # 6. split boot artifacts present - //Current boots them, and every snapshot
    #    entry limine-snapper-sync writes is a clone of //Current
    local missing='' file
    for file in "${SPLIT_BOOT_FILES[@]}"; do
        as_root test -f "$file" || missing="${missing}${missing:+, }${file##*/}"
    done
    if ! action_run 'Split boot artifacts (kernel, initramfs, microcode)'  \
                    "[ -z '$missing' ]"                                   \
                    'present'                                             \
                    "missing ${missing}"; then
        printf_error "%s missing from the ESP - //Current and every snapshot entry boot them (re-run configure-boot)\n" "$missing"
        exit 1
    fi

    # 7. kernel cmdline present (written by configure-boot) - fills //Current
    if ! action_run "Kernel cmdline ${STYLE_CLR}/etc/kernel/cmdline"  \
                    'as_root test -s /etc/kernel/cmdline'             \
                    'present'                                         \
                    'missing'; then
        printf_error "/etc/kernel/cmdline not found - run configure-boot first\n"
        exit 1
    fi
}


verify_home_prerequisites() {
    #
    # Check the home target: /home must be a btrfs subvolume of the cryptroot
    # filesystem, since its holder is created as a sibling there. findmnt
    # reports a subvolume as '/dev/mapper/cryptroot[/@home]', hence the strip.
    #
    local home_src home_fstype
    home_src=$(findmnt -n -o SOURCE /home 2>>"$LOG_FILE")
    home_fstype=$(findmnt -n -o FSTYPE /home 2>>"$LOG_FILE")

    if ! action_run "Home subvolume on ${STYLE_CLR}${CRYPT_DEV}"                        \
                    "[ '$home_fstype' = 'btrfs' ] && [ '${home_src%%[*}' = '$CRYPT_DEV' ]" \
                    'btrfs subvolume'                                                   \
                    "${home_fstype:-not mounted}"; then
        printf_error "/home is not a btrfs subvolume of ${CRYPT_DEV} - home snapshots require the configure-disk layout\n"
        exit 1
    fi
}


install_sync_tool() {
    #
    # Build + install the AUR snapshot-sync companion with yay (runs as the
    # normal user; yay shells out to sudo pacman internally, so cache the
    # password first). Step of the "Installing Limine" section.
    #
    action_request_permission 'to install AUR packages with yay'
    action_run "Install ${STYLE_CLR}$(gum style --bold --foreground "$GUM_YELLOW" "$AUR_SYNC_TOOL")"  \
        "yay -S --needed --noconfirm ${AUR_SYNC_TOOL}"                             \
        'done'
    assert $? "can't install ${AUR_SYNC_TOOL}"
}


install_limine_bootloader() {
    #
    # Seed the ESP with the Limine binary and install the pacman hook that
    # redeploys it on every limine upgrade. Step of the "Installing Limine"
    # section.
    #
    action_request_permission 'to deploy Limine to the ESP'
    action_run "Create ${STYLE_CLR}/boot/EFI/limine"  \
        'as_root mkdir -p /boot/EFI/limine'           \
        'done'
    assert $? "can't create /boot/EFI/limine"

    action_install_file '/etc/pacman.d/hooks/99-limine.hook' "$LIMINE_HOOK_URL" "$(check_sudo)"

    action_run "Deploy ${STYLE_CLR}${LIMINE_EFI_DST##*/}${STYLE_DIM} to the ESP"  \
        "as_root cp '$LIMINE_EFI_SRC' '$LIMINE_EFI_DST' && as_root sync"          \
        'done'
    assert $? "can't deploy ${LIMINE_EFI_DST}"
}


# shellcheck disable=SC2329
build_limine_conf() {
    #
    # Assemble the Limine config into $tmp: the theme (if selected) goes first
    # so it sits above the settings + boot entries - same order as the manual
    # install (save the theme, then append the config). The '>>' redirects stay
    # inside this function so action_run's appended '&>> LOG' can't clobber them.
    #
    local tmp="$1" want_theme="$2" theme_url="$3" conf_url="$4"

    if [ "$want_theme" = true ]; then
        curl -fsSL "$theme_url" >> "$tmp" || return 1
    fi
    curl -fsSL "$conf_url" >> "$tmp" || return 1
}


# shellcheck disable=SC2329
fill_kernel_cmdline() {
    #
    # Replace the kernel_cmdline placeholder in the assembled config ($1) with the
    # literal contents of /etc/kernel/cmdline, so //Current - and every snapshot
    # limine-snapper-sync clones from it - carries the real cmdline. Pure-bash
    # substitution: the cmdline holds '=', '/', '.' (and maybe '&'/'\') that a
    # sed/awk replacement would mangle, and it must not ride into a bash -c string.
    # /etc/kernel/cmdline is written by configure-boot and gated in verify_prerequisites.
    #   $1 conf - assembled config (user-owned temp)
    #
    local conf="$1"
    local placeholder='<put /etc/kernel/cmdline content>'
    local cmdline body

    cmdline=$(as_root cat /etc/kernel/cmdline 2>>"$LOG_FILE") || return 1
    [ -n "$cmdline" ] || return 1
    body=$(< "$conf") || return 1
    # Quote the replacement itself: outer quotes do not suppress patsub_replacement
    printf '%s\n' "${body/"$placeholder"/"$cmdline"}" > "$conf"
}


write_limine_config() {
    #
    # Assemble limine.conf (theme first when selected, then settings + boot
    # entries) and fill //Current's kernel_cmdline from /etc/kernel/cmdline.
    # Confirms + backs up an existing config first. Step of the
    # "Installing Limine" section.
    #
    action_request_permission 'to write /boot/limine.conf'

    # An existing config means a prior setup - confirm before clobbering it, and
    # keep a backup if we proceed. /boot is root-only (umask 0077), so the
    # existence test needs root.
    if is_package_installed 'limine' && as_root test -f "$LIMINE_CONF"; then
        printf_action "%b ${STYLE_DIM}${LIMINE_CONF} already exists${STYLE_CLR}\n" \
            "$(bullet_info)"
        printf_action 'Back up and replace? '
        if ! ask_yn; then
            printf_action "%b ${STYLE_DIM}keeping existing config - skipping${STYLE_CLR}\n" \
                "$(bullet_info)"
            return 0
        fi

        # An empty name means no backup was made - never proceed to overwrite
        # the config the user just asked to keep a copy of.
        local backup_name
        backup_name=$(backup_file "$LIMINE_CONF" "$(check_sudo)")
        [ -n "$backup_name" ] || assert 1 "can't back up $LIMINE_CONF"
        printf_action "Backup created: ${STYLE_CLR}${backup_name}\n"
    fi

    # Assemble into a temp: theme leads (if selected), settings + entries follow.
    trap '_snapshots_cleanup' EXIT
    _SNAPSHOTS_TEMP_FILE=$(mktemp)
    assert $? "can't create temporary file"
    local conf_tmp="$_SNAPSHOTS_TEMP_FILE"

    export -f build_limine_conf
    action_run 'Assemble limine.conf'                                                        \
        "build_limine_conf '$conf_tmp' '$WANT_THEME' '$LIMINE_THEME_URL' '$LIMINE_CONF_URL'"  \
        'done'
    assert $? "can't assemble limine.conf"

    export -f fill_kernel_cmdline
    action_run 'Embed kernel cmdline into //Current'  \
        "fill_kernel_cmdline '$conf_tmp'"             \
        'done'
    assert $? "can't embed /etc/kernel/cmdline into limine.conf"

    action_run "Install ${STYLE_CLR}${LIMINE_CONF}"   \
        "$(check_sudo) cp '$conf_tmp' '$LIMINE_CONF'" \
        'done'
    assert $? "can't install $LIMINE_CONF"
    rm -f "$conf_tmp"
    assert $? "can't remove $conf_tmp"
    _SNAPSHOTS_TEMP_FILE=''
    trap - EXIT
}


move_deep_config_aside() {
    #
    # Rename an existing /boot/EFI/limine/limine.conf out of the way. Limine
    # prefers <EFI app dir>/limine.conf over the partition root, but
    # limine-snapper-sync only updates the root one - a surviving deep copy is
    # what actually boots, and it goes stale (kernel panic) the moment a
    # snapshot is created. Renamed rather than deleted so a hand-written config
    # isn't lost. Runs on every path, including the "keep the existing config"
    # one, so the deep copy can't outlive a re-run. Step of the
    # "Installing Limine" section.
    #
    action_request_permission 'to move the stale deep Limine config aside'

    # /boot is root-only (umask 0077), so every existence test needs root.
    if ! as_root test -e "$DEEP_LIMINE_CONF"; then
        action_run "Stale ${STYLE_CLR}${DEEP_LIMINE_CONF}" '' 'absent'
        return 0
    fi

    local idx=1
    while as_root test -e "${DEEP_LIMINE_CONF}.bak${idx}"; do
        ((idx++))
    done

    local backup="${DEEP_LIMINE_CONF}.bak${idx}"
    action_run "Move ${STYLE_CLR}${DEEP_LIMINE_CONF}${STYLE_DIM} aside"  \
        "as_root mv '$DEEP_LIMINE_CONF' '$backup'"                       \
        'done'
    assert $? "can't move $DEEP_LIMINE_CONF aside"

    printf_action "%b ${STYLE_DIM}deep config renamed to ${STYLE_CLR}${backup}${STYLE_DIM} - it would have overridden ${STYLE_CLR}${LIMINE_CONF}${STYLE_CLR}\n" \
        "$(bullet_warning)"
}


# shellcheck disable=SC2329
use_builtin_menu_font() {
    #
    # Drop the external-bitmap directives so Limine falls back to its built-in
    # font. term_font_scale stays - it scales the built-in font too.
    # remove_line reports success for a missing file, so check it up front -
    # a silent no-op would leave term_font pointing at a bitmap never deployed.
    #   $1 conf    - limine.conf path
    #   $2 prefix  - sudo prefix (from check_sudo)
    #
    local conf="$1" prefix="$2"

    $prefix test -f "$conf" || return 1
    remove_line "$conf" '^term_font:' "$prefix" && remove_line "$conf" '^term_font_size:' "$prefix"
}


deploy_menu_font() {
    #
    # Point the Limine menu at the selected font. The term_font directive lives
    # in the theme block, so this is a no-op without the theme. 'default' keeps
    # Limine's built-in font (no bitmap); the named fonts deploy their raw bitmap
    # to the ESP root and, when not the baked-in spleen, repoint term_font. Folds
    # under the "Installing Limine" section.
    #
    [ "$WANT_THEME" = true ] || return 0

    action_request_permission 'to set the Limine menu font'

    if [ "$LIMINE_FONT" = 'default' ]; then
        export -f use_builtin_menu_font
        action_run 'Use built-in Limine menu font'                 \
            "use_builtin_menu_font '$LIMINE_CONF' '$(check_sudo)'"  \
            'done'
        assert $? "can't drop term_font lines in $LIMINE_CONF"
        return 0
    fi

    # The bitmap is a fixed asset - install it only when absent, so a re-run
    # doesn't litter the ESP root (which Limine reads) with .bakN copies.
    local font_file="${LIMINE_FONT}-8x16.bin"
    if as_root test -f "/boot/${font_file}"; then
        action_run "Menu font ${STYLE_CLR}${font_file}" '' 'present'
    else
        action_install_file "/boot/${font_file}" "${LIMINE_FONT_BASE_URL}/${font_file}" "$(check_sudo)"
    fi

    # Only spleen is baked into limine-theme.conf - repoint term_font for the rest.
    if [ "$LIMINE_FONT" != 'spleen' ]; then
        action_run "Point ${STYLE_CLR}term_font${STYLE_DIM} at ${STYLE_CLR}${font_file}"                  \
            "replace_line '$LIMINE_CONF' '^term_font:.*' 'term_font: boot():/${font_file}' $(check_sudo)"  \
            'done'
        assert $? "can't repoint term_font in $LIMINE_CONF"
    fi
}


register_limine_nvram() {
    #
    # Register Limine as a separate NVRAM entry, then reorder so the UKI boots
    # first and Limine second. Idempotent: skip create if the entry exists. Step
    # of the "Installing Limine" section.
    #
    action_require_package 'efibootmgr'
    action_request_permission 'to manage NVRAM boot entries'

    if as_root efibootmgr 2>>"$LOG_FILE" | grep -qF "$LIMINE_LABEL"; then
        printf_action "%b ${STYLE_DIM}entry ${STYLE_CLR}${LIMINE_LABEL}${STYLE_DIM} already present - skipping create${STYLE_CLR}\n" \
            "$(bullet_info)"
    else
        action_run "Register ${STYLE_CLR}$(gum style --bold --foreground "$GUM_YELLOW" "$LIMINE_LABEL")"  \
            "as_root efibootmgr --create --disk '$ESP_DISK' --part $ESP_IDX            \
                                --label '$LIMINE_LABEL'                                \
                                --loader '$LIMINE_LOADER' --unicode"                   \
            'done'
        assert $? "can't register Limine in NVRAM"
    fi

    export UKI_LABEL LIMINE_LABEL
    export -f reorder_bootorder
    if ! action_run 'Reorder boot entries (UKI first, Limine second)'  \
                    'reorder_bootorder'                                \
                    'done'                                             \
                    'UKI entry not found'; then
        printf_action "%b ${STYLE_DIM}reorder skipped - set it manually: ${STYLE_CLR}efibootmgr --bootorder <UKI>,<Limine>,…${STYLE_CLR}\n" \
            "$(bullet_warning)"
    fi
}


install_sync_defaults() {
    #
    # /etc/default/limine drives limine-snapper-sync (and limine-entry-tool once
    # the Secure Boot step installs it). Step of the "Installing Limine"
    # section.
    #
    action_request_permission 'to write /etc/default/limine'
    action_install_file '/etc/default/limine' "$LIMINE_DEFAULT_URL" "$(check_sudo)"
}


install_boot_hooks() {
    #
    # Install the post.d hooks limine-snapper-sync runs after it rewrites
    # limine.conf: 81-limine-strip-resume (always - idempotent, a no-op without
    # hibernation) and, when selected, 80-limine-flatten-snapshots. Must land
    # before the initial sync so the first written config is already scrubbed.
    # Backups must be non-executable or end in .disabled: upstream executes
    # every other executable file in post.d. Step of "Installing Limine".
    #
    action_request_permission 'to install limine post.d hooks'

    action_run "Create ${STYLE_CLR}${BOOT_HOOKS_DIR}"  \
        "as_root mkdir -p '${BOOT_HOOKS_DIR}'"         \
        'done'
    assert $? "can't create ${BOOT_HOOKS_DIR}"

    # strip-resume: always (hibernation safety; harmless when no resume= present)
    local strip_dst="${BOOT_HOOKS_DIR}/81-limine-strip-resume"
    install_boot_hook "$strip_dst" "$LIMINE_STRIP_HOOK_URL"

    # Deselecting must also disable the hook and stale copies from earlier runs
    local flat_dst="${BOOT_HOOKS_DIR}/80-limine-flatten-snapshots"
    if [ "$WANT_FLATTEN" = true ]; then
        install_boot_hook "$flat_dst" "$LIMINE_FLATTEN_HOOK_URL"
    else
        action_run 'Disable snapshot menu flattening'             \
            "_snapshots_disable_hook_copies '$flat_dst' true"     \
            'disabled'
        assert $? "can't disable $flat_dst"
    fi
}


install_boot_hook() {
    #
    # Download a hook before changing its live copy, then install it executable.
    # Keep backups excluded from hook execution, including legacy .bakN copies.
    # Exits through assert on failure and removes the download through EXIT.
    #
    # Parameters:
    #   $1 - dest - hook destination.
    #   $2 - url - hook download URL.
    #
    # Example:
    #   install_boot_hook "$strip_dst" "$LIMINE_STRIP_HOOK_URL"
    #
    local dest="$1" url="$2"

    action_request_permission 'to install a Limine boot hook'
    trap '_snapshots_cleanup' EXIT
    _SNAPSHOTS_TEMP_FILE=$(mktemp)
    assert $? "can't create temporary hook file"

    action_run "Download ${STYLE_CLR}${dest##*/}"                       \
        "curl -fsSL '$url' -o '$_SNAPSHOTS_TEMP_FILE'"                   \
        'done'
    assert $? "can't download $url"

    action_run "Back up ${STYLE_CLR}${dest##*/}${STYLE_DIM} safely"     \
        "_snapshots_backup_hook '$dest'"                               \
        'done'
    assert $? "can't back up $dest or disable its old hook copies"

    action_run "Install ${STYLE_CLR}${dest##*/}"                        \
        "$(check_sudo) install -m 0755 '$_SNAPSHOTS_TEMP_FILE' '$dest'"  \
        'done'
    assert $? "can't install $dest"

    rm -f "$_SNAPSHOTS_TEMP_FILE"
    assert $? "can't remove $_SNAPSHOTS_TEMP_FILE"
    _SNAPSHOTS_TEMP_FILE=''
    trap - EXIT
}


ensure_holder() {
    #
    # Make sure the snapshot-holder subvolume and its fstab entry exist, creating
    # them when missing (configure-disk normally provisions them; this covers the
    # case it didn't). Idempotent.
    #
    #   $1 subvol  - sibling holder subvolume (@snapshots | @home-snapshots)
    #   $2 snapdir - its mountpoint (/.snapshots | /home/.snapshots)
    #
    local subvol="$1" snapdir="$2"

    action_request_permission 'to provision the snapshot holder'

    # Validate active fields before any Snapper creation/deletion. Comments and
    # other mountpoints are not entries for this holder; conflicts are not edited.
    action_run "Validate fstab entry for ${STYLE_CLR}${snapdir}"                     \
        "_snapshots_ensure_fstab '/etc/fstab' '$subvol' '$snapdir' '$CRYPT_UUID' check" \
        'valid or absent'                                                             \
        'missing file or conflicting entry'
    assert $? "check /etc/fstab: $snapdir needs one btrfs entry with UUID=$CRYPT_UUID and subvol=$subvol"

    # Create the sibling subvolume if absent. It can't be made from inside @, so
    # mount the btrfs top-level (subvolid=5) at a temp mountpoint.
    local subvolumes
    subvolumes=$(as_root btrfs subvolume list / 2>>"$LOG_FILE")
    assert $? "can't list btrfs subvolumes"
    if grep -qE "[[:space:]]path ${subvol}$" <<< "$subvolumes"; then
        printf_action "%b ${STYLE_DIM}subvolume ${STYLE_CLR}${subvol}${STYLE_DIM} exists${STYLE_CLR}\n" \
            "$(bullet_info)"
    else
        trap '_snapshots_cleanup' EXIT
        _SNAPSHOTS_TOP=$(mktemp -d)
        assert $? "can't create temp mountpoint"
        local top="$_SNAPSHOTS_TOP"

        action_run "Mount cryptroot top-level at ${STYLE_CLR}${top}"  \
            "as_root mount -o subvolid=5 '$CRYPT_DEV' '$top'"         \
            'done'
        assert $? "can't mount cryptroot top-level"

        action_run "Create subvolume ${STYLE_CLR}${subvol}"  \
            "as_root btrfs subvolume create '$top/$subvol'"  \
            'done'
        assert $? "can't create $subvol"

        action_run "Unmount top-level ${STYLE_CLR}${top}"  \
            "as_root umount '$top'"                        \
            'done'                                         \
            'busy'
        assert $? "can't unmount $top"

        rmdir "$top" 2>>"$LOG_FILE"
        assert $? "can't remove $top"
        _SNAPSHOTS_TOP=''
        trap - EXIT
    fi

    # Do not leave a boot-time mount entry pointing at a subvolume creation that failed
    action_run "Ensure fstab entry for ${STYLE_CLR}${snapdir}"                  \
        "_snapshots_ensure_fstab '/etc/fstab' '$subvol' '$snapdir' '$CRYPT_UUID'" \
        'done'
    assert $? "can't ensure fstab entry for $snapdir - check for conflicting entries"

    action_run 'Reload systemd unit cache'      \
        "$(check_sudo) systemctl daemon-reload" \
        'done'
    assert $? 'daemon-reload failed'
}


validate_holder_path() {
    #
    # Refuse conflicting mounts or nonempty nested layouts before provisioning.
    # Empty remnants of interrupted setup can be safely cleared later.
    #
    # Parameters:
    #   $1 - snapdir - intended holder mountpoint.
    #   $2 - subvol - expected sibling name on CRYPT_UUID.
    #
    # Example:
    #   validate_holder_path /.snapshots @snapshots
    #
    local snapdir="$1" subvol="$2"

    action_request_permission 'to inspect the snapshot holder'
    if as_root mountpoint -q "$snapdir"; then
        action_run "Validate mounted holder ${STYLE_CLR}${snapdir}"               \
            "_snapshots_is_holder_mounted '$snapdir' '$subvol' '$CRYPT_UUID'"      \
            'correct'                                                              \
            'wrong filesystem or subvolume'
        assert $? "$snapdir is not $subvol on UUID=$CRYPT_UUID - resolve the mount manually"
    else
        action_run "Check unmounted holder path ${STYLE_CLR}${snapdir}"  \
            "_snapshots_is_empty_snapdir '$snapdir'"                      \
            'empty or absent'                                             \
            'nonempty or unavailable'
        assert $? "$snapdir contains data or cannot be inspected - resolve the layout manually"
    fi
}


mount_holder() {
    #
    # Mount the sibling for both new and existing configs, then verify its
    # actual filesystem and subvolume before permissions or retention change.
    # Only empty nested remnants are removed; existing snapshots are preserved.
    #
    # Parameters:
    #   $1 - snapdir - holder mountpoint with a validated fstab entry.
    #   $2 - subvol - expected sibling name on CRYPT_UUID.
    #
    # Example:
    #   mount_holder /home/.snapshots @home-snapshots
    #
    local snapdir="$1" subvol="$2"

    action_request_permission 'to mount the snapshot holder'
    if ! as_root mountpoint -q "$snapdir"; then
        action_run "Clear empty nested holder ${STYLE_CLR}${snapdir}"  \
            "_snapshots_remove_empty_snapdir '$snapdir'"                \
            'done'                                                       \
            'not empty or unavailable'
        assert $? "can't clear $snapdir - preserve existing data and resolve the layout manually"

        action_run "Create mountpoint ${STYLE_CLR}${snapdir}"  \
            "$(check_sudo) mkdir '$snapdir'"                    \
            'done'
        assert $? "can't create $snapdir"

        action_run "Mount sibling holder at ${STYLE_CLR}${snapdir}"  \
            "$(check_sudo) mount --target '$snapdir'"                 \
            'done'
        assert $? "can't mount $snapdir - check its fstab entry"
    fi

    action_run "Verify sibling holder at ${STYLE_CLR}${snapdir}"             \
        "_snapshots_is_holder_mounted '$snapdir' '$subvol' '$CRYPT_UUID'"      \
        'correct'                                                              \
        'wrong filesystem or subvolume'
    assert $? "$snapdir is not $subvol on UUID=$CRYPT_UUID - resolve the mount manually"
}


configure_snapper_config() {
    #
    # Create a snapper config, swap snapper's throwaway nested .snapshots for
    # the sibling holder, set permissions, and apply retention. Provisions the
    # holder first. Existing configs skip only creation, never holder validation
    # or mounting. Nonempty nested layouts are refused, not migrated.
    #
    #   $1 cfg          - snapper config name (root | home)
    #   $2 target       - subvolume mountpoint (/ | /home)
    #   $3 snapdir      - sibling .snapshots mountpoint
    #   $4 subvol       - sibling holder subvolume (@snapshots | @home-snapshots)
    #   $5 retention_fn - exported function applying the retention policy
    #
    local cfg="$1" target="$2" snapdir="$3" subvol="$4" retention_fn="$5"

    printf_section "Configuring Snapper for ${STYLE_CLR}%b\n"  \
        "$(gum style --bold --foreground "$GUM_YELLOW" "$target")"

    action_request_permission "to configure snapper for ${target}"

    # snapper is installed once, by whichever target section runs first (root
    # when selected). create-config needs it; ensure_holder doesn't.
    if [ "$cfg" = 'root' ] || [ "$WANT_ROOT" = false ]; then
        action_require_package 'snapper'
    fi

    # Refuse wrong mounts and data that a sibling mount would otherwise hide
    validate_holder_path "$snapdir" "$subvol"
    ensure_holder "$subvol" "$snapdir"

    if as_root snapper list-configs 2>>"$LOG_FILE" | grep -qw "$cfg"; then
        printf_action "%b ${STYLE_DIM}config ${STYLE_CLR}${cfg}${STYLE_DIM} exists - skipping create-config${STYLE_CLR}\n" \
            "$(bullet_info)"
    else
        # If the holder is currently mounted (pre-provisioned), unmount it so
        # create-config can make - and we can delete - its throwaway subvol.
        if as_root mountpoint -q "$snapdir"; then
            action_run "Unmount sibling holder ${STYLE_CLR}${snapdir}"  \
                "$(check_sudo) umount '$snapdir'"                        \
                'done'                                                  \
                'busy'
            assert $? "can't unmount $snapdir"
        fi

        action_run "Clear empty mountpoint ${STYLE_CLR}${snapdir}"  \
            "_snapshots_remove_empty_snapdir '$snapdir'"            \
            'done'                                                   \
            'not empty or unavailable'
        assert $? "can't clear $snapdir - preserve existing data and resolve the layout manually"

        action_run "Create snapper config ${STYLE_CLR}${cfg}"   \
            "as_root snapper -c '$cfg' create-config '$target'" \
            'done'
        assert $? "can't create snapper config $cfg"
    fi

    mount_holder "$snapdir" "$subvol"

    action_run "Set ${STYLE_CLR}${snapdir}${STYLE_DIM} ownership and mode"  \
        "as_root chmod 750 '$snapdir' && as_root chown :wheel '$snapdir'"   \
        'done'
    assert $? "can't set permissions on $snapdir"

    action_run "Apply ${STYLE_CLR}${cfg}${STYLE_DIM} retention policy"  \
        "$retention_fn"                                                 \
        'done'
    assert $? "can't apply $cfg retention"

    # snap-pac walks SNAPPER_CONFIGS; create-config adds the config there.
    if [ "$cfg" = 'root' ]; then
        action_run 'Verify snap-pac wired (SNAPPER_CONFIGS)'  \
            "as_root grep -qw 'root' /etc/conf.d/snapper"     \
            'root'                                            \
            'missing'
    fi
}


enable_limine_snapper_sync() {
    #
    # Run an initial sync and enable the inotify-driven service that turns each
    # new snapshot into a Limine boot entry. Folds under the "Configuring
    # Snapper for /" section (prints no header of its own).
    #
    action_request_permission 'to enable limine-snapper-sync'

    # No snapshots exist yet, so this writes no entries - it's the check that the
    # config parses and TARGET_OS_NAME resolves to an entry holding a //Current
    # kernel node. Fatal: arming the watcher and snap-pac on top of a config the
    # tool can't read yields snapshots with no boot entry.
    action_run 'Run initial sync'      \
        'as_root limine-snapper-sync'  \
        'done'
    assert $? 'limine-snapper-sync failed - check TARGET_OS_NAME and the //Current kernel entry'

    action_run 'Enable limine-snapper-sync.service'                  \
        'as_root systemctl enable --now limine-snapper-sync.service' \
        'enabled'
    assert $? "can't enable limine-snapper-sync.service"
}


enable_cleanup_timer() {
    #
    # snapper-cleanup.timer runs the cleanup algorithms (NUMBER_*,
    # EMPTY_PRE_POST_*, TIMELINE_CLEANUP) over every config - without it the
    # retention policy is written but never enforced. One timer covers both
    # configs, so it folds under whichever target section runs first (prints no
    # header of its own).
    #
    action_request_permission 'to enable snapper-cleanup.timer'
    action_run 'Enable snapper-cleanup.timer'                  \
        'as_root systemctl enable --now snapper-cleanup.timer' \
        'enabled'
    assert $? "can't enable snapper-cleanup.timer"
}


install_snap_pac() {
    #
    # Install snap-pac LAST - it's the trigger that turns each pacman
    # transaction into a snapper pre/post pair. Installing it only now, with the
    # root config registered and the limine-snapper-sync watcher live, keeps the
    # configuration's own package installs from creating snapshots before the
    # pipeline is ready. (alpm fixes the hook set at transaction start, so
    # snap-pac never snapshots its own install - the first pair fires on the
    # user's next pacman -Syu.) Folds under the "Configuring Snapper for /"
    # section as its final action.
    #
    action_require_package 'snap-pac'
}


enable_timeline_timer() {
    #
    # One timer walks every config with TIMELINE_CREATE=yes (just 'home' here).
    # The drop-in lands first: the timer ships OnCalendar=hourly, and the home
    # config's TIMELINE_LIMIT_* only steer cleanup, so without it snapper
    # creates 24 snapshots a day for cleanup to prune 23 back out. Folds under
    # the "Configuring Snapper for /home" section (prints no header of its own).
    #
    action_request_permission 'to enable snapper-timeline.timer'

    action_run "Create ${STYLE_CLR}${TIMELINE_DROPIN_DIR}"  \
        "as_root mkdir -p '${TIMELINE_DROPIN_DIR}'"         \
        'done'
    assert $? "can't create ${TIMELINE_DROPIN_DIR}"

    action_install_file "${TIMELINE_DROPIN_DIR}/${TIMELINE_DROPIN}" \
                        "$TIMELINE_DROPIN_URL"                      \
                        "$(check_sudo)"

    # Picks up the drop-in on a re-run, where the timer is already loaded
    action_run 'Reload systemd manager configuration'  \
        'as_root systemctl daemon-reload'              \
        'done'
    assert $? "can't reload the systemd manager configuration"

    action_run 'Enable snapper-timeline.timer'                  \
        'as_root systemctl enable --now snapper-timeline.timer' \
        'enabled'
    assert $? "can't enable snapper-timeline.timer"
}


main() {

    ## Refuse to run as root
    # yay / makepkg cannot build as root; privileged steps use as_root instead.
    if [ "$EUID" -eq 0 ]; then
        printf_error "%b\n" 'this script must be run as a non-root user (AUR tools cannot build as root)'
        exit 1
    fi

    ## Init

    action_start_tui

    ## Targets and options

    select_snapshot_targets || return 0

    # Limine only ever boots root snapshots - skip its options for a home-only run.
    if [ "$WANT_ROOT" = true ]; then
        select_limine_options || return 0
    fi

    ## Pre-flight

    verify_prerequisites

    ## Snapper - per-target configs, sync service, snap-pac trigger, timers

    # Retention helpers run inside action_run's bash -c subshell - export them.
    export -f apply_root_retention apply_home_retention

    # root: Limine (bootloader, AUR tools, config, NVRAM, sync defaults) first,
    # since the snapshot pipeline boots through it. enable_limine_snapper_sync,
    # enable_cleanup_timer and install_snap_pac print no header - they fold
    # under "Configuring Snapper for /". snap-pac is last.
    if [ "$WANT_ROOT" = true ]; then
        install_limine
        configure_snapper_config 'root' '/' '/.snapshots' '@snapshots' 'apply_root_retention'
        enable_limine_snapper_sync
        enable_cleanup_timer
        install_snap_pac
    fi

    # home: enable_timeline_timer folds under its section, and so does the
    # cleanup timer when no root section ran ahead of it.
    if [ "$WANT_HOME" = true ]; then
        configure_snapper_config 'home' '/home' '/home/.snapshots' '@home-snapshots' 'apply_home_retention'
        [ "$WANT_ROOT" = true ] || enable_cleanup_timer
        enable_timeline_timer
    fi

    ## Closing tips

    if [ "$WANT_ROOT" = true ]; then
        printf_info "%b\n" 'reboot to confirm the Limine menu, then run pacman -Syu to trigger the first snapshot pair'
        printf_info "%b\n" 'after the first sync: grep -i resume /boot/limine.conf - resume= must show only on //Current'
    else
        printf_info "%b\n" 'home snapshots are timeline-driven - list them with snapper -c home list'
    fi

    return 0
}


## Internal


# Bash cannot hide these helpers; the prefix marks script-private implementation.

_snapshots_ensure_fstab() {
    #
    # Ensure exactly one active UUID-based btrfs entry at the requested target.
    # Append a missing entry unless mode is check; reject duplicates, wrong
    # sources/types/subvolumes, or unreadable files without rewriting. libmount parses
    # comments and escaped fields, rather than a regex scanning arbitrary text.
    #
    # Parameters:
    #   $1 - fstab - mount table to read and append to.
    #   $2 - subvol - expected sibling subvolume name.
    #   $3 - snapdir - exact mountpoint.
    #   $4 - uuid - expected filesystem UUID.
    #   $5 - mode - (optional) - append (default) or check without writing.
    #
    # Example:
    #   _snapshots_ensure_fstab /etc/fstab @snapshots /.snapshots "$CRYPT_UUID"
    #
    local fstab="$1" subvol="$2" snapdir="$3" uuid="$4" mode="${5-append}"
    local entries source fstype options option
    local found=false
    local -a mount_options

    as_root test -r "$fstab" || return 1
    if entries=$(as_root findmnt --fstab --tab-file "$fstab" --raw --noheadings  \
                    --output SOURCE,FSTYPE,OPTIONS --mountpoint "$snapdir"   \
                    2>&1); then
        [[ $entries != *$'\n'* ]] || return 1 # duplicate mountpoint or parser diagnostic
        read -r source fstype options <<< "$entries"
        [[ $source = "UUID=${uuid}" && $fstype = 'btrfs' ]] || return 1
        IFS=',' read -r -a mount_options <<< "$options"
        for option in "${mount_options[@]}"; do
            [[ $option = subvol=* ]] || continue
            [[ $found = false ]] || return 1
            [[ $option = "subvol=${subvol}" || $option = "subvol=/${subvol}" ]] || return 1
            found=true
        done
        [[ $found = true ]] || return 1
        return 0
    else
        [[ $? -eq 1 && -z $entries ]] || return 1
    fi

    # findmnt returns 1 without output when the exact target has no active entry
    [[ $mode = check ]] && return 0
    printf '\nUUID=%s  %s  btrfs  subvol=%s,noatime  0 0\n' "$uuid" "$snapdir" "$subvol" \
        | as_root tee -a "$fstab" &>> "$LOG_FILE"
}


_snapshots_is_holder_mounted() {
    #
    # Match the actual mount, not the filesystem containing an unmounted path.
    # Reject other filesystems, subvolumes and stacked mounts with extra rows.
    #
    # Parameters:
    #   $1 - snapdir - exact mountpoint.
    #   $2 - subvol - expected sibling name.
    #   $3 - uuid - expected filesystem UUID.
    #
    # Example:
    #   _snapshots_is_holder_mounted /.snapshots @snapshots "$CRYPT_UUID"
    #
    local snapdir="$1" subvol="$2" uuid="$3"
    local mounted

    mounted=$(as_root findmnt --raw --noheadings --mountpoint "$snapdir"  \
                  --output UUID,FSTYPE,FSROOT 2>>"$LOG_FILE") || return 1
    [[ $mounted = "$uuid btrfs /$subvol" ]] || return 1
    return 0
}


_snapshots_is_empty_snapdir() {
    #
    # Accept only an absent path or empty, unmounted directory/subvolume.
    # Refuse symlinks and fail closed when directory inspection fails.
    #
    # Parameters:
    #   $1 - snapdir - path to inspect, including hidden entries.
    #
    # Example:
    #   _snapshots_is_empty_snapdir /home/.snapshots
    #
    local snapdir="$1"
    local entries

    as_root test -x "${snapdir%/*}/" || return 1
    as_root test -L "$snapdir" && return 1
    if ! as_root test -e "$snapdir"; then
        return 0
    fi
    as_root test -d "$snapdir" || return 1
    if as_root mountpoint -q "$snapdir"; then
        return 1
    else
        [[ $? -eq 32 ]] || return 1 # inspection failure is not an unmounted path
    fi
    entries=$(as_root find "$snapdir" -mindepth 1 -maxdepth 1 -print -quit  \
                  2>>"$LOG_FILE") || return 1
    [[ -z $entries ]] || return 1
    return 0
}


_snapshots_remove_empty_snapdir() {
    #
    # Remove only an empty, unmounted directory or throwaway nested subvolume.
    # Never recursively delete user snapshots or hide them below a new mount.
    #
    # Parameters:
    #   $1 - snapdir - path to clear before creation or mounting.
    #
    # Example:
    #   _snapshots_remove_empty_snapdir /.snapshots
    #
    local snapdir="$1"

    _snapshots_is_empty_snapdir "$snapdir" || return 1
    as_root test -e "$snapdir" || return 0
    if as_root btrfs subvolume show "$snapdir" &>> "$LOG_FILE"; then
        as_root btrfs subvolume delete "$snapdir"
    else
        as_root rmdir "$snapdir"
    fi
}


_snapshots_disable_hook_copies() {
    #
    # Remove execution permission from legacy backups and optionally the hook.
    # Only this managed hook's .bakN copies are touched, not other boot hooks.
    #
    # Parameters:
    #   $1 - hook - canonical hook path.
    #   $2 - disable_current - whether to disable the canonical hook too.
    #
    # Example:
    #   _snapshots_disable_hook_copies "$flat_dst" true
    #
    local hook="$1" disable_current="$2"

    as_root find "${hook%/*}" -maxdepth 1 -type f -name "${hook##*/}.bak[0-9]*" \
        -exec chmod a-x '{}' + || return 1
    if [[ $disable_current = true ]] && as_root test -e "$hook"; then
        as_root chmod a-x "$hook" || return 1
    fi
    return 0
}


_snapshots_backup_hook() {
    #
    # Preserve the live hook under a unique name excluded by upstream's runner.
    # Repair executable backups left by action_install_file on previous runs.
    #
    # Parameters:
    #   $1 - hook - canonical hook path; an absent hook needs no backup.
    #
    # Example:
    #   _snapshots_backup_hook "$strip_dst"
    #
    local hook="$1"
    local idx=1

    _snapshots_disable_hook_copies "$hook" false || return 1
    as_root test -e "$hook" || return 0
    while as_root test -e "${hook}.bak${idx}.disabled"; do
        ((idx++))
    done
    as_root cp "$hook" "${hook}.bak${idx}.disabled"
}


_snapshots_cleanup() {
    #
    # Release owned temporary resources without changing the original exit code.
    # Never prompt during cleanup or remove a still-mounted top-level directory.
    #
    # Parameters:
    #   None.
    #
    # Example:
    #   trap '_snapshots_cleanup' EXIT
    #
    local status=$?
    local -a root_command=()
    [[ $EUID -eq 0 ]] || root_command=(sudo -n)

    if [[ -n $_SNAPSHOTS_TEMP_FILE ]]; then
        rm -f "$_SNAPSHOTS_TEMP_FILE" 2>>"$LOG_FILE"
    fi
    if [[ -n $_SNAPSHOTS_TOP ]]; then
        if "${root_command[@]}" mountpoint -q "$_SNAPSHOTS_TOP"; then
            if ! "${root_command[@]}" umount "$_SNAPSHOTS_TOP" &>> "$LOG_FILE"; then
                printf_warning 'cleanup could not unmount %s - unmount it manually\n' "$_SNAPSHOTS_TOP"
                return "$status"
            fi
        else
            if [[ $? -ne 32 ]]; then
                printf_warning 'cleanup could not inspect %s - check the mount manually\n' "$_SNAPSHOTS_TOP"
                return "$status"
            fi
        fi
        rmdir "$_SNAPSHOTS_TOP" 2>>"$LOG_FILE"
    fi
    return "$status"
}


## Export Functions


# Holder validation and preparation
export -f _snapshots_ensure_fstab _snapshots_is_holder_mounted
export -f _snapshots_is_empty_snapdir _snapshots_remove_empty_snapdir

# Boot hook backups
export -f _snapshots_disable_hook_copies _snapshots_backup_hook


## Source-Time Initialization


# common owns SIGINT; SIGTERM also needs to pass through the active EXIT cleanup
trap 'exit 143' TERM

main "$@"
