{
  "lastChangelogVersion": "1.4.0",

  "theme": "dark-legacy",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "auto",
  "fullscreenWheelScrollLines": 5,
  "autocompleteMaxVisible": 10,
  "quietStartup": "header",
  "hideThinkingBlock": false,
  "doubleEscapeAction": "none",
  "treeFilterMode": "no-tools",

  "defaultTools": ["+codemode"],
  "codemode": {
    "mode": "on"
  },
  
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol"
  ],

  "collapseChangelog": true,
  "warnings": {
    "anthropicExtraUsage": false
  },

  "showHardwareCursor": false,
  "showCacheMissNotices": false,

  "compaction": {
    "enabled": true
  },

  "packages": [
    {
      "source": "npm:@javargasm/pi-usage-bars",
      "extensions": [
        "+extensions/usage-bars/index.ts"
      ]
    },
    {
      "source": "npm:pi-web-providers",
      "extensions": [
        "+dist/index.js"
      ]
    },
    {
      "source": "npm:@gotgenes/pi-permission-system",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "npm:@tmustier/pi-usage-extension",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:pi-context-view",
    "npm:@oresk/tidy-bash",
    "npm:@gotgenes/pi-anthropic-auth",
    {
      "source": "npm:pi-ayu-themes",
      "themes": [
        "-themes/ayu-light.json"
      ]
    },
    "npm:pi-delete",
    "npm:@eko24ive/pi-ask",
    {
      "source": "npm:@mblarsen/pi-update-changelog",
      "extensions": [
        "-index.ts"
      ]
    }
  ]
}
