{
  "theme": "dark",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "auto",
  "fullscreenWheelScrollLines": 5,
  "autocompleteMaxVisible": 5,
  "quietStartup": "header",
  "hideThinkingBlock": false,
  "doubleEscapeAction": "none",
  "treeFilterMode": "no-tools",
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "on"
  },
  "cacheWarming": "idle",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra",
    "anthropic/claude-fable-5-2"
  ],
  "collapseChangelog": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "showHardwareCursor": false,
  "showCacheMissNotices": false,
  "compaction": {
    "enabled": true
  },
  "packages": [
    {
      "source": "npm:@javargasm/pi-usage-bars",
      "extensions": [
        "+extensions/usage-bars/index.ts"
      ]
    },
    {
      "source": "npm:@gotgenes/pi-permission-system",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "npm:@tmustier/pi-usage-extension",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:pi-context-view",
    "npm:@oresk/tidy-bash",
    "npm:@gotgenes/pi-anthropic-auth",
    {
      "source": "npm:pi-ayu-themes",
      "themes": [
        "-themes/ayu-light.json"
      ]
    },
    "npm:pi-delete",
    "npm:@eko24ive/pi-ask",
    "npm:webfox",
    {
      "source": "npm:pi-tui-prompt-box",
      "extensions": [
        "+src/index.ts"
      ]
    }
  ]
}
